# ---------- 清理技能生成规则 (2026-08-11) ----------
# 编译中间产物目录（javac 可再生）
.scannerwork/
out_test/
out_test_ui/
# JMeter 压测结果（jtl 为结果日志，可重跑生成）
**/*.jtl
# jar/war 测试垃圾目录（已清，防复发：fixtures 压测夹具 / dist_input 构建中间产物）
bempdiff/fixtures/
bempdiff/dist_input/

# ---------- npm 本地缓存 (2026-08-16) ----------
# 切勿用 `npm install --cache /d/code/...`（Git Bash POSIX 路径）传给 Windows 原生 npm，
# 会被归一化成 D:\d\... 误生成目录。构建脚本走默认全局缓存，不依赖项目本地缓存。
.npmcache*
bempdiff/webui/.npmcache*

# ---------- Electron 桌面壳依赖 (2026-08-17) ----------
# dev-shell 的 npm install 产物，体积大且可重装，不纳入版本控制（仅改忽略规则，不删文件）
bempdiff/dev-shell/node_modules/

# ---------- 扫描/测试临时产物 (2026-08-18) ----------
# 清理/诊断技能运行期落地的临时报告与日志，非源码、可重跑生成，不纳入版本控制
.comp_err.txt
.fix_strategies.json
.issues.csv
.remaining_issues.csv
.scan_log*.txt
.test_log*.txt

# ---------- vite/vitest 临时配置文件 (2026-08-18) ----------
# vite 在 dev/build 时生成的临时 config 副本，非源码
vite.config.js.timestamp-*.mjs
vitest.config.js.timestamp-*.mjs

# ---------- 工作空间清理规则 (2026-08-28, workspace-cleanup) ----------
# 本轮清理的品类均为可再生构建产物/缓存/运行时日志/临时垃圾，勿再入库。

# 根目录堆放的无用垃圾（PowerShell 编译错误误重定向产物等）
/Join-Path
/_repro_dl.js
/build_run.log

# 前端 vite 构建输出（非打包必需，可由 npm run build 重生）
bempdiff/webui/dist/

# 各子项目 node_modules 依赖（可由 npm install 重生）
bempdiff/dev-shell/node_modules/
# 根 .gitignore 已有全局 node_modules/ 规则，会覆盖 bempdiff/node_modules、
# bempdiff/webui/node_modules 及其它所有同名目录；此处单列 dev-shell 仅作明确备注。

# 后端 javac 编译中间产物目录
bempdiff/java_core/out/
bempdiff/java_core/test_classes/
bempdiff/java_core/test_out/
bempdiff/java_core/vr_classes/

