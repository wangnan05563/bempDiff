{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "BempDiff 默认权限：核心 + 原生文件/文件夹对话框（免上传，直接拿绝对路径）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
