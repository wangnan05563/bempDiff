{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BempDiff",
  "version": "0.1.0",
  "identifier": "com.bempdiff.app",
  "build": {
    "frontendDist": "../dist_input/webui",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "echo frontend-bundled-by-build_tauri_app.ps1"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist_input/app/bempdiff.jar": "app/bempdiff.jar",
      "../dist_input/app/cfr.jar": "app/cfr.jar",
      "../dist_input/app/lib": "app/lib",
      "../dist_input/jre": "jre",
      "../dist_input/webui": "webui"
    },
    "createUpdaterArtifacts": false,
    "publisher": "BempDiff",
    "category": "DeveloperTool"
  },
  "plugins": {}
}
