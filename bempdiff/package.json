{
  "name": "bempdiff",
  "version": "0.1.2026083020",
  "private": true,
  "description": "BempDiff 桌面应用根（Electron 桌面壳 + Web 前端 + Java 后端 sidecar）",
  "scripts": {
    "dev": "cd webui && npm run dev",
    "build": "cd webui && npm run build",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "electronVersion": "31.7.7",
    "appId": "com.bempdiff.app",
    "productName": "BempDiff",
    "copyright": "Copyright © 2026 BempDiff",
    "directories": {
      "app": "dev-shell",
      "output": "../release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist_input/app",
        "to": "bempdiff/dist_input/app"
      },
      {
        "from": "dist_input/jre",
        "to": "bempdiff/dist_input/jre"
      },
      {
        "from": "dist_input/webui",
        "to": "bempdiff/dist_input/webui"
      },
      {
        "from": "bempdiff-logo.png",
        "to": "bempdiff-logo.png"
      }
    ],
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": "nsis",
      "icon": "bempdiff-logo.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BempDiff-${version}-setup.${ext}",
      "include": "build/installer.nsh"
    }
  }
}
